{
  "files.exclude": {
    "**/.devdb": true,
    "**/__pycache__": true
  },
  "search.exclude": {
    "**/.devdb": true,
    "**/.venv": true,
    "**/__pycache__": true
  },
  "files.associations": {
    "*.sql": "sql"
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],
  "python.testing.cwd": "${workspaceFolder}/backend",
  "sqltools.connections": [
    {
      "name": "kbfa_dev (local)",
      "driver": "PostgreSQL",
      "server": "localhost",
      "port": 5432,
      "database": "kbfa_dev",
      "username": "${env:USER}"
    }
  ],
  "editor.formatOnSave": false
}
